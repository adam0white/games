{
  "name": "smoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Smoke on the Stairs: a night fire, four neighbours, and a voice they can refuse.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/stamp-release.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:lane": "pnpm lint && pnpm typecheck",
    "deploy": "cd ../.. && pnpm run deploy",
    "deploy:check": "cd ../.. && pnpm run deploy:check",
    "ci:check": "pnpm e2e"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.17.0",
    "@adam0white/lab-client": "https://github.com/adam0white/human-framework/releases/download/lab-client-v0.5.18/adam0white-lab-client-0.5.18.tgz",
    "@adam0white/lab-kit": "https://github.com/adam0white/human-framework/releases/download/lab-kit-v0.5.35/adam0white-lab-kit-0.5.35.tgz",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
