{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!pnpm-lock.yaml",
      "!.wrangler",
      "!test/fixtures/*.json",
      "!scratch",
      "!docs/playtests/*.json",
      "!.claude",
      "!archive"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "docs/design.md",
        "docs/playtests/2026-10-20-r3-tester-c.md",
        "docs/playtests/2026-10-20-r3-tester-d.md"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
