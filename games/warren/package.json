{
  "name": "warren",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "The Warren: a village digs a refuge into soft stone. Nobody obeys; everyone follows the worn path.",
  "license": "MIT",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "stamp-release && vite build",
    "preview": "vite preview",
    "test": "vitest run --testTimeout=60000 --maxWorkers=2",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "pnpm run check && pnpm run build && pnpm exec wrangler deploy",
    "check:lane": "npm run check",
    "check:unused": "knip"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.17.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.5.15.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.32.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "knip": "6.44.1",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0",
    "hf410": "npm:@adam0white/human-framework@4.10.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
