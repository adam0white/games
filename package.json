{
  "name": "hearsay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hearsay: a fortnight of talk, trust and consequences in a hillside mahalle.",
  "license": "MIT",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stamp-release.ts && vite build",
    "preview": "vite preview",
    "test": "node scripts/suite-lock.ts -- vitest run --testTimeout=60000 --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "node scripts/deploy.ts",
    "check:lane": "npm run lint && npm run typecheck",
    "knip": "knip",
    "build:garden-replay": "node scripts/build-garden-replay.ts",
    "test:garden-replay-consumer": "node scripts/test-garden-replay-consumer.ts",
    "test:first-minute": "node test/browser/first-minute.mjs"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.17.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.5.12.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.29.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0",
    "knip": "6.44.1",
    "@adam0white/hf-legacy": "npm:@adam0white/human-framework@3.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
