{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "games-static",
  "main": "src/worker.mjs",
  "account_id": "a20259cba74e506296745f9c67c1f3bc",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "routes": [
    {
      "pattern": "play.adamwhite.work",
      "custom_domain": true
    },
    {
      "pattern": "repair.adamwhite.work/sw.js",
      "zone_name": "adamwhite.work"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
    "issues": { "enabled": true }
  }
}
