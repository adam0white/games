{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!.wrangler",
      "!test/fixtures/*.json",
      "!scratch",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "docs/design.md",
        "docs/findings.md",
        "docs/hf-requests.md",
        "docs/playtests/adversarial-2026-10-18.md",
        "docs/playtests/designer-2026-10-18.md",
        "docs/playtests/fable-2026-10-18.md",
        "docs/playtests/guide-2026-10-18.md",
        "docs/playtests/owner-2026-10-18.md",
        "docs/probes/hf4-2026-10-28/README.md"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
