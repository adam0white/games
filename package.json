    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scheduler": "0.28.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "knip": "6.43.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
