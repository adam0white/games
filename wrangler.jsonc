{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "games-static",
  "main": "src/worker.mjs",
  "account_id": "a20259cba74e506296745f9c67c1f3bc",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  // Required by `wrangler preview`, which Workers Builds runs for pull requests. Previews need no separate settings.
  "previews": {},
  "routes": [
    {
      "pattern": "play.adamwhite.work",
      "custom_domain": true
    },
    {
      "pattern": "rope.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "hearsay.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "goodhands.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "glance.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "repair.adamwhite.work/sw.js",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "valley.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "murmur.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "stairwell.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "pass.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "warren.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "commonstead.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "child.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "neighbours.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "lefthand.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "days.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "word.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "smoke.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    },
    {
      "pattern": "island.adamwhite.work/*",
      "zone_name": "adamwhite.work"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
