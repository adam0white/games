{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rope",
  "account_id": "a20259cba74e506296745f9c67c1f3bc",
  "compatibility_date": "2026-11-05",
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rope.adamwhite.work", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // Kill switch for the camp voice: set to "off" (and deploy) to stop all model calls.
  "vars": { "CAMP_AI": "off" },
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
    "issues": { "enabled": true }
  }
}
