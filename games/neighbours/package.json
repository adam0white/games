{
  "name": "neighbours",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "check:lane": "pnpm --dir neighbours run lint && pnpm --dir neighbours run typecheck && pnpm --dir neighbours run test:node-imports",
    "test": "pnpm --dir neighbours run test",
    "check": "pnpm run check:lane && pnpm run test",
    "build": "pnpm --dir neighbours run build && node scripts/copy-dist.mjs",
    "deploy": "cd ../.. && pnpm run deploy",
    "ci:check": "node scripts/ci-check.mjs"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.17.0",
    "@adam0white/lab-client": "https://github.com/adam0white/human-framework/releases/download/lab-client-v0.5.19/adam0white-lab-client-0.5.19.tgz",
    "@adam0white/lab-kit": "https://github.com/adam0white/human-framework/releases/download/lab-kit-v0.5.36/adam0white-lab-kit-0.5.36.tgz"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "releaseMetadata": "release-metadata.json"
}
