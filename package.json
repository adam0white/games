{
  "name": "repair-game",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:archives": "node scripts/build-archives.mjs",
    "test": "node scripts/suite-lock.ts -- vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests vite.config.ts",
    "format": "biome check --write src tests vite.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prebuild": "node scripts/stamp-release.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --dry-run",
    "check:lane": "npm run check",
    "knip": "knip"
  },
  "dependencies": {
    "@adam0white/human-framework": "3.0.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.4.10.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.11.tgz",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "knip": "6.43.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "@adam0white/human-framework": "$@adam0white/human-framework"
  }
}
