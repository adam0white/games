{
  "name": "stairwell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Stairwell: you are the new caretaker of a seven-flat block. Everyone tells you things.",
  "license": "MIT",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "cd ../.. && pnpm run deploy",
    "check:lane": "npm run lint && npm run typecheck",
    "test:first-minute": "node test/browser/first-minute.mjs",
    "deploy:check": "cd ../.. && pnpm run deploy:check"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.17.0",
    "@adam0white/lab-client": "https://github.com/adam0white/human-framework/releases/download/lab-client-v0.5.18/adam0white-lab-client-0.5.18.tgz",
    "@adam0white/lab-kit": "https://github.com/adam0white/human-framework/releases/download/lab-kit-v0.5.35/adam0white-lab-kit-0.5.35.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.7",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "packageManager": "pnpm@12.16.1"
}
