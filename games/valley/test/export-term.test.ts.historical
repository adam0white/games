import { expect, it } from 'vitest';
import { ownerInputs } from '../scripts/owner-schedule.ts';
import { compactRun, fingerprint, load, replay, save } from '../src/sim/game.ts';
import pins from './fixtures/hf4151-fingerprints.json';

it('keeps the current cast day-12 schedule below 5 KB and replays to its recorded fingerprint', () => {
  const g = replay(406153184, ownerInputs, 17550, undefined, true, 'valley-public-2026-10');
  expect(fingerprint(g.valley)).toBe(pins.day12);
  const run = compactRun(save(g));
  expect(run).toEqual(compactRun(g));
  expect(Buffer.byteLength(JSON.stringify(run))).toBeLessThan(5_000);
  expect(run).not.toHaveProperty('state');
  expect(run).not.toHaveProperty('savedAt');
  expect(run).toMatchObject({
    game: 'valley',
    seed: 406153184,
    version: '0.4.0',
    framework: '4.16.3',
    minute: 17550,
    inputs: ownerInputs,
    fingerprint: pins.day12,
    label: 'Volume I, 30 July of year one',
  });
  expect(fingerprint(load(JSON.parse(JSON.stringify(run))).valley)).toBe(pins.day12);
}, 120_000);
