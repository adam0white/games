{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!.wrangler",
      "!test/fixtures/*.json",
      "!scratch",
      "!test-results",
      "!playwright-report",
      "!docs/playtests/*.json",
      "!.claude",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "docs/cast-adoption.md",
        "docs/concept.md",
        "docs/games/commonstead-playtest-2026-10-27.md",
        "docs/games/commonstead-playtest-2026-10-27b.md",
        "docs/reading-plan.md",
        "docs/work-orders-plan.md"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
