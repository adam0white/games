{
  "name": "word",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "His Word: negotiate practical promises after a tailor dies.",
  "license": "MIT",
  "engines": {
    "node": "26.12.0"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm story && vite --host 127.0.0.1",
    "story": "node scripts/build.ts --story-only",
    "build": "node scripts/build.ts && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm story && tsc -p tsconfig.json",
    "test": "pnpm story && vitest run",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:lane": "pnpm check",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.17.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.4.15.tgz",
    "inkjs": "2.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
