{
  // Starting point for a new Worker in this repository. Copy it to workers/<name>/wrangler.jsonc.
  // scripts/observability.test.mjs fails the build when a Worker that runs code lacks the observability block.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "games-<name>",
  "account_id": "a20259cba74e506296745f9c67c1f3bc",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "play.adamwhite.work/<name>/*", "zone_name": "adamwhite.work" }],
  // Readable stack traces in Issues.
  "upload_source_maps": true,
  // Logs, traces and Issues: see workers/OBSERVABILITY.md.
  "observability": {
    "enabled": true,
    // Query strings never reach logs or traces.
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    // 1 for a Worker with little traffic; 0.1 for one that runs on every page or asset request.
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    // Cloudflare groups uncaught exceptions, 5xx responses and console.error into issues. The watcher starts Claude on a new one.
    "issues": { "enabled": true }
  }
}
