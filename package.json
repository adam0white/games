{
  "name": "repair-game",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:archives": "node scripts/build-archives.mjs",
    "test": "node scripts/suite-lock.ts -- vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests vite.config.ts",
    "format": "biome check --write src tests vite.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prebuild": "node scripts/stamp-release.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --dry-run",
    "check:lane": "npm run check",
    "knip": "knip"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.7.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.5.3.tgz",
